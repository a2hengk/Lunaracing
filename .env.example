# Werte aus dem Vercel-Dashboard: Projekt → Storage → Neon-Datenbank bzw. Blob Store → Tab ".env.local"
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# direkte Verbindung ohne Pooler, für Migrationen
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require
# Vercel Blob (Store öffentlich), zum Hochladen der Rundendaten beim Import
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
