# Am einfachsten: `npx vercel link` und dann `npx vercel env pull .env.local`
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# optional, direkte Verbindung für Migrationen
DATABASE_URL_UNPOOLED=
# Vercel Blob (Store öffentlich), zum Hochladen der Rundendaten beim Import
BLOB_READ_WRITE_TOKEN=
